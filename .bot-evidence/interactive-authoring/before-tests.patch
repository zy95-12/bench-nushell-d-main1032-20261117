+#[test]
+fn nu_schema_includes_lsp_mode() {
+    let (_, _, engine, _) = new_engine();
+    let value = engine
+        .get_var(nu_protocol::NU_VARIABLE_ID)
+        .const_val
+        .as_ref()
+        .unwrap();
+    assert_eq!(
+        value
+            .as_record()
+            .unwrap()
+            .get("is-lsp")
+            .unwrap()
+            .as_bool()
+            .unwrap(),
+        false
+    );
+}
+
+#[test]
+fn signature_completion_shapes_are_plain() {
+    let (_, _, engine, _) = new_engine();
+    let mut working_set = StateWorkingSet::new(&engine);
+    parse(&mut working_set, None, b"def values [] { [one two] }; def demo [arg: string@values --flag: string@values] {}", false);
+    assert!(working_set.parse_errors.is_empty());
+    let signature = working_set.get_decl(working_set.find_decl(b"demo").unwrap()).signature();
+    assert_eq!(signature.required_positional[0].shape, nu_protocol::SyntaxShape::String);
+    assert_eq!(signature.get_long_flag("flag").unwrap().arg, Some(nu_protocol::SyntaxShape::String));
+}
+
+#[test]
+fn commandline_accept_modes() {
+    let (_, _, mut engine, mut stack) = new_engine();
+    engine = nu_cli::add_cli_context(engine);
+    for (mode, expected, cursor) in [
+        ("--replace", "XY", 2),
+        ("--insert", "aXYb", 3),
+        ("--append", "abXY", 1),
+    ] {
+        {
+            let mut repl = engine.repl_state.lock().unwrap();
+            repl.buffer = "ab".into();
+            repl.cursor_pos = 1;
+        }
+        let command = format!("commandline edit {mode} -A XY");
+        support::merge_input(command.as_bytes(), &mut engine, &mut stack).unwrap();
+        let repl = engine.repl_state.lock().unwrap();
+        assert_eq!(repl.buffer, expected);
+        assert_eq!(repl.cursor_pos, cursor);
+    }
+}
